# Server-only HV1 origin. No staff token is required or forwarded.
TELEMED_API_ORIGIN=https://healthx-api.kindrock-9a3ea2bc.southeastasia.azurecontainerapps.io
# Only enables isolated demo accounts in next dev; ignored in production.
TELEMED_DEMO_AUTH_ENABLED=false
# Optional Dev workflow. Use the normal authenticated backend, not catalog port 3102.
# Keep these server-only and configure the same secret on the backend.
TELEMED_WORKFLOW_ORIGIN=https://healthx-api.kindrock-9a3ea2bc.southeastasia.azurecontainerapps.io
# TELEMED_DEMO_BRIDGE_SECRET=<random secret, at least 32 characters>
